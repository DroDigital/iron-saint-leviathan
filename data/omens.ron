// Omens: stackable run modifiers with reward multipliers (Tide Runs, optional NG+).
[
    (
        id: "glass_hull",
        name: "Glass Hull",
        desc: "You die in one hit.",
        reward: 3.0,
        effects: [GlassHull],
    ),
    (
        id: "famine",
        name: "Famine",
        desc: "Hunger drains twice as fast; Saints' reactors run lean.",
        reward: 1.4,
        effects: [Famine(2.0), StatMul(StaminaRegen, 0.85)],
    ),
    (
        id: "black_signal",
        name: "Black Signal",
        desc: "No HUD.",
        reward: 1.5,
        effects: [NoHud],
    ),
    (
        id: "riptide",
        name: "Riptide",
        desc: "Every district is partly flooded.",
        reward: 1.3,
        effects: [Riptide],
    ),
    (
        id: "pilgrim",
        name: "Pilgrim",
        desc: "No lock-on.",
        reward: 1.5,
        effects: [NoLock],
    ),
    (
        id: "echo",
        name: "Echo",
        desc: "Enemies copy your last used move.",
        reward: 1.6,
        effects: [Echo],
    ),
    (
        id: "iron_tide",
        name: "Iron Tide",
        desc: "Enemies have 40% more HP.",
        reward: 1.4,
        effects: [EnemyHp(1.4)],
    ),
    (
        id: "red_moon",
        name: "Red Moon",
        desc: "Enemies deal 30% more damage.",
        reward: 1.5,
        effects: [EnemyDamage(1.3)],
    ),
    (
        id: "quickened",
        name: "Quickened",
        desc: "Enemies move 15% faster.",
        reward: 1.3,
        effects: [EnemySpeed(1.15)],
    ),
    (
        id: "thin_blood",
        name: "Thin Blood",
        desc: "Heals restore half as much.",
        reward: 1.4,
        effects: [HealMul(0.5)],
    ),
    (
        id: "undertow",
        name: "Undertow",
        desc: "Death drops sink immediately.",
        reward: 1.3,
        effects: [NoRecovery],
    ),
    (
        id: "hallowed",
        name: "Hallowed Ground",
        desc: "Your posture breaks faster.",
        reward: 1.2,
        effects: [StatMul(Posture, 0.75)],
    ),
]
