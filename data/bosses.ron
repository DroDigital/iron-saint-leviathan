            (
                at_hp: 0.3,
                moves: [("warden_combo", 3), ("warden_feint", 3), ("warden_charge", 3), ("warden_bash", 1)],
                speed: 1.2,
                line: "WARDEN: ...who is in here with me?",
            ),
        ],
        currency: 1200,
        reaction: 14,
        intro: "The first Saint stands in the surf where the ferries used to dock.",
        bestiary: "Harbor Warden. Iron Saint chassis, factory loadout. Its feint is always the same length.",
        chassis: "iron_saint",
    ),
