[
    (
        id: "boss_iron_saint",
        name: "IRON SAINT",
        title: "The Harbor Warden",
        side: Saint,
        parts: ("iron_saint_hull", "iron_saint_shield", "iron_saint_blade", "iron_saint_legs", "iron_saint_reliquary", "iron_saint_halo", "iron_saint_thrusters"),
