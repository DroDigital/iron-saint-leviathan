            (
                at_hp: 0.6,
                moves: [("warden_combo", 3), ("warden_cleave", 3), ("warden_charge", 2), ("warden_feint", 2)],
                speed: 1.1,
                line: "WARDEN: I have done this before. I will do this again.",
